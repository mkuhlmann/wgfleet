# Server Port
# Defaults to 3000 if unset; switch local dev to 3100
PORT=3100

# WireGuard Execution Mode
# WG_DEV_SHIM=true   -> Force mocking (in-memory dev shim; no real WireGuard/network changes)
# WG_DEV_SHIM=false  -> Force local execution (executes real wg, wg-quick, ip, and nft commands)
# (Leave unset to auto-detect system capabilities)
WG_DEV_SHIM=true

# Admin Bearer Token (optional, minimum 16 characters)
# If unset, a random 32-character token is generated on each startup
# ADMIN_TOKEN=your-fixed-admin-token-here

# Database File Path (defaults to ../../data/sqlite.db relative to packages/server)
# DATABASE_PATH=../../data/sqlite.db

# Traffic Statistics Collection (defaults to true)
# WG_TRAFFIC_STATS_ENABLED=true
